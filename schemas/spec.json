{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "spec",
  "type": "object",
  "additionalProperties": false,
  "required": ["decisions", "nonGoals", "acceptance"],
  "properties": {
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "choice", "why"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 80 },
          "choice": { "type": "string", "minLength": 1, "maxLength": 600 },
          "why": { "type": "string", "minLength": 1, "maxLength": 400 }
        }
      }
    },
    "nonGoals": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "acceptance": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    }
  }
}
