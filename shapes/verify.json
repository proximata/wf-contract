{
  "type": "object",
  "additionalProperties": false,
  "required": ["checks", "verdict"],
  "properties": {
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "cmd", "pass", "evidence"],
        "properties": {
          "name": { "type": "string", "maxLength": 120 },
          "cmd": { "type": "string", "maxLength": 200 },
          "pass": { "type": "boolean" },
          "evidence": { "type": "string", "minLength": 1, "maxLength": 1200 }
        }
      }
    },
    "verdict": { "type": "string", "enum": ["pass", "fail", "blocked"] }
  }
}
