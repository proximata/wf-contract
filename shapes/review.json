{
  "type": "object",
  "additionalProperties": false,
  "required": ["findings", "blocking"],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sev", "loc", "claim", "fix"],
        "properties": {
          "sev": { "type": "string", "enum": ["blocker", "major", "minor", "nit"] },
          "loc": { "type": "string", "maxLength": 200 },
          "claim": { "type": "string", "maxLength": 500 },
          "fix": { "type": "string", "maxLength": 500 }
        }
      }
    },
    "blocking": { "type": "boolean" }
  }
}
